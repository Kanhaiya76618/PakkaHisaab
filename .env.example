# Frontend: public Supabase browser configuration and API endpoints.
# Set by Vercel automatically; local development may use `development`.
NODE_ENV=development
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>
NEXT_PUBLIC_API_URL=http://localhost:8000
# WebSocket base URL used by the Agent Terminal (defaults from NEXT_PUBLIC_API_URL when omitted).
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Backend: server-only Supabase credentials and external integrations.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
SUPABASE_JWT_SECRET=<supabase-jwt-secret>
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# OpenAI, reachable one of two ways. Azure wins when both are set.
OPENAI_API_KEY=<openai-api-key>
# Azure OpenAI: routes by DEPLOYMENT NAME, not model id, and requires
# `max_completion_tokens` rather than `max_tokens`. Serves chat-modality tasks only —
# transcription and speech need their own deployments or a direct OpenAI key.
AZURE_OPENAI_API_KEY=<azure-openai-api-key>
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT_NAME=<your-chat-deployment-name>
AZURE_OPENAI_API_VERSION=2024-10-21
# Sarvam AI: Indic speech-to-text (saaras:v3) and text-to-speech (bulbul:v3).
# Optional — without it the router falls back to Whisper/OpenAI TTS and logs the fallback.
SARVAM_API_KEY=<sarvam-api-subscription-key>
MOCK_MODE=false
DEMO_STORE_ID=00000000-0000-0000-0000-000000000001
# Railway backend only: exact Vercel production URL, no trailing slash.
FRONTEND_ORIGIN=https://<project>.vercel.app
